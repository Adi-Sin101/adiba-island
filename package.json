{
  "name": "adiba-island",
  "version": "1.0.0",
  "private": true,
  "description": "Adiba Tahsin's toy-island portfolio with a Payload CMS admin dashboard",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "sync:github": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/sync-github.ts",
    "admin:password": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/set-admin-password.ts",
    "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run build",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-vercel-blob": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "payload": "^3.90.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
